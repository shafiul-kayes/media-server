{
  "name": "media-server",
  "version": "1.2.0",
  "description": "Secure self-hosted image & PDF hosting server with REST API (imgbb/uploadcare style)",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "db:setup": "node scripts/db-setup.js",
    "db:schema": "node scripts/db-setup.js --print-sql",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "create-key": "node scripts/create-key.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "sharp": "^0.35.5",
    "swagger-ui-dist": "^5.33.0"
  },
  "devDependencies": {
    "mysql-memory-server": "^1.16.0"
  }
}
