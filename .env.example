# ---- Server ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Public address used in returned URLs. Use https in production, ideally a separate
# domain from your main site (e.g. https://media.example.com).
PUBLIC_BASE_URL=http://localhost:3000
# Set when running behind a reverse proxy (nginx, Cloudflare): number of hops, e.g. 1.
TRUST_PROXY=false

# ---- Secrets (generate with: npm run setup) ----
ADMIN_TOKEN=
SIGNING_SECRET=

# ---- MySQL database ----
# Create the database and a dedicated user first (see database/create-user.sql),
# then run: npm run db:setup
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=media_server
DB_USER=media_server
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Use TLS when MySQL runs on another machine. DB_SSL_CA = path to the server's CA certificate.
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- File storage ----
# mysql = image/PDF bytes are stored inside MySQL (LONGBLOB tables file_blobs, file_variants)
# disk  = bytes are stored as files under STORAGE_DIR, only metadata goes to MySQL
# Existing files stay readable after switching, because each file records where it lives.
STORAGE_DRIVER=mysql
STORAGE_DIR=./storage

# ---- Upload limits ----
MAX_FILE_SIZE_MB=10
MAX_IMAGE_PIXELS=60000000
MAX_ANIMATION_FRAMES=300
DEFAULT_QUOTA_MB=1024
# Longest allowed auto-delete ("expiration") in seconds (180 days)
MAX_EXPIRATION_SECONDS=15552000
# Longest allowed signed URL lifetime for private files (7 days)
MAX_SIGNED_URL_SECONDS=604800

# ---- PDF safety ----
PDF_BLOCK_ACTIVE_CONTENT=true
PDF_ALLOW_ENCRYPTED=false

# ---- Upload from URL (imgbb style "image=https://...") ----
# Private/loopback/cloud-metadata addresses are always blocked.
REMOTE_UPLOAD_ENABLED=true
REMOTE_UPLOAD_TIMEOUT_MS=15000
REMOTE_UPLOAD_MAX_REDIRECTS=3

# ---- Image transformations ----
MAX_TRANSFORM_DIMENSION=4096
MAX_VARIANTS_PER_FILE=20

# ---- Browser access ----
# Origins allowed to call the API from a browser for EVERY key (empty = none).
# Prefer per-key allowed_origins (npm run create-key -- --origins https://mysite.com).
CORS_ORIGINS=
# Who may embed files in an iframe: * (anyone), 'self', or origins like https://example.com
FRAME_ANCESTORS=*

# ---- Rate limits ----
RATE_LIMIT_API_PER_15MIN=300
RATE_LIMIT_UPLOADS_PER_HOUR=100
RATE_LIMIT_AUTH_FAILURES_PER_15MIN=20
RATE_LIMIT_PUBLIC_PER_MIN=600
RATE_LIMIT_TRANSFORMS_PER_MIN=60
RATE_LIMIT_ADMIN_PER_15MIN=50
RATE_LIMIT_DELETE_PAGE_PER_15MIN=60
